rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isValidUserProfile(data) {
      return data.keys().hasAll(['createdAt', 'updatedAt'])
        && ( !('barrierType' in data) || (data.barrierType is string && data.barrierType.size() <= 100))
        && ( !('concerns' in data) || (data.concerns is list && data.concerns.size() <= 50))
        && ( !('recommendedIngredients' in data) || (data.recommendedIngredients is list && data.recommendedIngredients.size() <= 100));
    }
    
    function isValidScan(data) {
      return data.keys().hasAll(['userId', 'productName', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.productName is string && data.productName.size() <= 500
        && ( !('summary' in data) || (data.summary is string && data.summary.size() <= 5000))
        && ( !('ingredients' in data) || (data.ingredients is list && data.ingredients.size() <= 500));
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
                    && isValidUserProfile(incoming())
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && request.auth.uid == userId
                    && isValidUserProfile(incoming())
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && request.auth.uid == userId;
      
      match /scans/{scanId} {
        allow read, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && isValidId(scanId) && request.auth.uid == userId
                      && isValidScan(incoming())
                      && incoming().createdAt == request.time
                      && incoming().updatedAt == request.time;
        allow update: if isSignedIn() && request.auth.uid == userId
                      && isValidScan(incoming())
                      && incoming().createdAt == existing().createdAt
                      && incoming().updatedAt == request.time
                      && incoming().userId == existing().userId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
