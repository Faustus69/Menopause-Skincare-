rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.uid == 'hCN44TadBZMVJC5mzKspDFWNYYL2' ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'needthis2027@gmail.com' && request.auth.token.email_verified == true)
      ); 
    }
    function isGuest() {
      return isSignedIn() && request.auth.token.email != null 
        && request.auth.token.email.lower() == 'guest@wisebloom.co.uk';
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isValidUserProfile(data) {
      return data.keys().hasAll(['createdAt', 'updatedAt'])
        && ( !('barrierType' in data) || data.barrierType == null || (data.barrierType is string && data.barrierType.size() <= 100))
        && ( !('concerns' in data) || (data.concerns is list && data.concerns.size() <= 50))
        && ( !('recommendedIngredients' in data) || (data.recommendedIngredients is list && data.recommendedIngredients.size() <= 100))
        && ( !('email' in data) || data.email == null || (data.email is string && data.email.size() <= 200))
        && ( !('isPaid' in data) || (data.isPaid is bool))
        && ( !('role' in data) || (data.role is string && data.role.size() <= 50))
        && ( !('stripeCustomerId' in data) || data.stripeCustomerId == null || (data.stripeCustomerId is string && data.stripeCustomerId.size() <= 100))
        && ( !('favorites' in data) || (data.favorites is list && data.favorites.size() <= 200))
        && ( !('routine' in data) || (data.routine is map))
        && ( !('notes' in data) || (data.notes is list && data.notes.size() <= 500))
        && ( !('scans' in data) || (data.scans is list && data.scans.size() <= 200))
        && ( !('lastResetAt' in data) || data.lastResetAt == null || (data.lastResetAt is string && data.lastResetAt.size() <= 100) || (data.lastResetAt is timestamp));
    }
    
    function isValidScan(data) {
      return data.keys().hasAll(['userId', 'productName', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.productName is string && data.productName.size() <= 500
        && ( !('summary' in data) || (data.summary is string && data.summary.size() <= 5000))
        && ( !('ingredients' in data) || (data.ingredients is list && data.ingredients.size() <= 500));
    }

    function isValidGuestInviteConfig(data) {
      return data.keys().hasAll(['active', 'version', 'updatedAt'])
        && data.keys().hasOnly(['token', 'tokenHash', 'active', 'version', 'createdAt', 'updatedAt'])
        && data.active is bool
        && data.version is int && data.version >= 0
        && ( !('token' in data) || (data.token is string && data.token.size() <= 200) )
        && ( !('tokenHash' in data) || (data.tokenHash is string && data.tokenHash.size() <= 128) );
    }

    function isValidGuestInvite(data) {
      return data.keys().hasAll(['active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['active', 'version', 'createdAt', 'updatedAt'])
        && data.active is bool
        && ( !('version' in data) || (data.version is int && data.version >= 1) );
    }

    match /app_config/{configId} {
      allow read, list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(configId) && isValidGuestInviteConfig(incoming()) && incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /guest_invites/{tokenHash} {
      // Only exact-hash lookup by authenticated sessions (to validate a presented invite token); never allow listing/enumeration.
      allow get: if isSignedIn() && isValidId(tokenHash);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(tokenHash) && isValidGuestInvite(incoming())
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(tokenHash) && isValidGuestInvite(incoming())
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      
      // On create: Ordinary users can ONLY set isPaid: false (or omit it) and role: 'customer'.
      // Admin and the recognized WiseBloom guest account are granted access.
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
                    && isValidUserProfile(incoming())
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time
                    && ( !('isPaid' in incoming()) || incoming().isPaid == false || isAdmin() || isGuest() )
                    && ( !('role' in incoming()) || incoming().role == 'customer' || isAdmin() || (isGuest() && incoming().role == 'guest') );
                    
      // On update: Ordinary users CANNOT change their isPaid status, role, or stripeCustomerId.
      // Admin can update any user to reset guest data or manage roles.
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin())
                    && isValidUserProfile(incoming())
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time
                    && ( incoming().isPaid == existing().isPaid || isAdmin() || isGuest() )
                    && ( incoming().role == existing().role || isAdmin() || (isGuest() && incoming().role == 'guest') )
                    && ( !('stripeCustomerId' in incoming()) || incoming().stripeCustomerId == existing().stripeCustomerId || isAdmin() );
                    
      allow delete: if isAdmin();
      
      match /scans/{scanId} {
        allow read, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && isValidId(scanId) && request.auth.uid == userId
                      && isValidScan(incoming())
                      && incoming().createdAt == request.time
                      && incoming().updatedAt == request.time;
        allow update: if isSignedIn() && request.auth.uid == userId
                      && isValidScan(incoming())
                      && incoming().createdAt == existing().createdAt
                      && incoming().updatedAt == request.time
                      && incoming().userId == existing().userId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
